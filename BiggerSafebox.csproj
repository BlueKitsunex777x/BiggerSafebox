<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BiggerSafebox</AssemblyName>
    <Version>1.1.1</Version>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- your Block Story folder, change it or pass /p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BlockStory</GameDir>
    <DataDir Condition="Exists('$(GameDir)/BlockStory_Data')">$(GameDir)/BlockStory_Data</DataDir>
    <DataDir Condition="'$(DataDir)' == ''">$(GameDir)/BlockStoryLinux_Data</DataDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="icon.png"><LogicalName>icon.png</LogicalName></EmbeddedResource>
  </ItemGroup>
</Project>
